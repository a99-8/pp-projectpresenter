        "fileName": "app/(dashboard)/metric-card.tsx",
        "code": "export async function MetricCard({ source, title }: Props) {\n  // كل بطاقة تجلب بياناتها بعمر كاش مستقل\n  const metric = await fetchMetric(source, {\n    next: { tags: [`metric-${source}`] },\n  });\n\n  return (\n    <Card>\n      <CardTitle>{title}</CardTitle>\n      <MetricValue value={metric.value} trend={metric.trend} />\n    </Card>\n  );\n}\n\n// في الصفحة: كل بطاقة داخل حد Suspense خاص بها\n// <Suspense fallback={<MetricSkeleton />}>\n//   <MetricCard source=\"deploys\" title=\"نشر اليوم\" />\n// </Suspense>"
