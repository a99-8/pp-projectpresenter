      "device": "desktop",
      "description": "جزء من منطق دمج العمليات الذي يحل تعارض التعديلات دون اتصال.",
      "content": {
        "type": "code",
        "language": "dart",
        "fileName": "lib/sync/sync_engine.dart",
        "code": "class SyncEngine {\n  final OperationLog _log;\n  final Firestore _remote;\n\n  /// يدمج العمليات المحلية مع السحابة بنظام\n  /// Last-Write-Wins على مستوى الحقل وليس السجل.\n  Future<void> push() async {\n    for (final op in _log.pending()) {\n      final doc = _remote.doc(op.taskId);\n      await _remote.runTransaction((tx) async {\n        final snap = await tx.get(doc);\n        final remoteStamp = snap.get('${op.field}__ts') as int? ?? 0;\n        if (op.timestamp > remoteStamp) {\n          tx.update(doc, {\n            op.field: op.value,\n            '${op.field}__ts': op.timestamp,\n          });\n        }\n      });\n      _log.markSynced(op.id);\n    }\n  }\n}"
      },
